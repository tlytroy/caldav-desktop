.webdav-state.json
*.md.bak

# 界面写入的配置（含 API Key / 密码，禁止入库）
config.json

# 同步 / 提醒的运行时状态（可重建，不入库）
.caldav-sync-state.json
.reminder-state.json
.workspace-backups/

# Docker / NAS 部署的数据目录
# （workspace.md + config.json + 状态文件都在里面）
data/

# 本机生成的 API token（v0.3 启动时生成，绝不能入库）
api-token.txt

# 桌面端打包中间产物（tsc + esbuild 输出，electron-builder 再生成 AppImage）
apps/desktop/dist-server/
