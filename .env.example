# ===== CalDAV Server Configuration =====
# Radicale or any CalDAV-compatible server
CALDAV_URL=http://localhost:5232
CALDAV_USER=your_username
CALDAV_PASS=your_password

# Server port
PORT=3001

# Electron configuration
VITE_API_URL=http://localhost:3001

# ===== MD ↔ ICS Bridge (events.md) =====
# The bridge uses a single events.md file as the canonical data store.
# All events are edited in this MD file locally, then converted to ICS at sync time.
# See REF/MD_ICS_BRIDGE.md for full design spec.

# Enable the MD bridge service
MD_ICS_ENABLED=false

# Path to the events.md file (the single source of truth for all calendar events)
# This file contains YAML frontmatter with an events[] array.
# Default: ./events.md (relative to app data directory)
MD_EVENTS_FILE=./events.md

# Sync direction: "md-to-caldav", "caldav-to-md", or "bidirectional"
MD_ICS_SYNC_DIRECTION=bidirectional

# Auto-sync interval in minutes (0 = manual only)
MD_ICS_AUTO_SYNC_MINUTES=0

# CalDAV calendar to push converted events to (leave empty to use first available)
MD_ICS_TARGET_CALENDAR_URL=

# ===== WebDAV Sync (alternative to CalDAV) =====
# If you don't have a CalDAV server, you can sync events.md directly via WebDAV.
# This is simpler: just sync the MD file itself, no ICS conversion needed.

# WebDAV URL for syncing events.md (e.g., https://nextcloud.example.com/remote.php/dav/files/user/)
WEBDAV_URL=
WEBDAV_USER=
WEBDAV_PASS=

# Remote path for events.md on the WebDAV server
WEBDAV_EVENTS_PATH=CalDAV-Desktop/events.md

# ===== AI Agent =====
# AI-powered calendar event extraction from meeting notes
# AI reads/writes events.md directly — no ICS protocol knowledge needed

# AI provider (openai-compatible)
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ===== Calendar Display =====
# Default date range for fetching events (days)
VITE_DEFAULT_DATE_RANGE_DAYS=30