# ===== CalDAV Server Configuration =====
# Radicale or any CalDAV-compatible server
CALDAV_URL=http://localhost:5232
CALDAV_USER=your_username
CALDAV_PASS=your_password

# Server port
PORT=3001

# Electron configuration
VITE_API_URL=http://localhost:3001

# ===== MD ↔ ICS Bridge (events.md) =====
# The bridge uses a single events.md file as the canonical data store.
# All events are edited in this MD file locally, then converted to ICS at sync time.
# See REF/MD_ICS_BRIDGE.md for full design spec.

# Enable the MD bridge service
MD_ICS_ENABLED=false

# Path to the events.md file (the single source of truth for all calendar events)
# This file contains YAML frontmatter with an events[] array.
# Default: ./events.md (relative to app data directory)
MD_EVENTS_FILE=./events.md

# Sync direction: "md-to-caldav", "caldav-to-md", or "bidirectional"
MD_ICS_SYNC_DIRECTION=bidirectional

# Auto-sync interval in minutes (0 = manual only)
MD_ICS_AUTO_SYNC_MINUTES=0

# CalDAV calendar to push converted events to (leave empty to use first available)
MD_ICS_TARGET_CALENDAR_URL=

# ===== WebDAV Sync (alternative to CalDAV) =====
# If you don't have a CalDAV server, you can sync events.md directly via WebDAV.
# This is simpler: just sync the MD file itself, no ICS conversion needed.
# Both events.md and 工作搭子看板.md are synced as-is.

# WebDAV URL for syncing md files (e.g., https://nextcloud.example.com/remote.php/dav/files/user/)
WEBDAV_URL=
WEBDAV_USER=
WEBDAV_PASS=

# Remote directory on the WebDAV server. Only the DIRECTORY part is used —
# the two md filenames are fixed (events.md / 工作搭子看板.md).
WEBDAV_EVENTS_PATH=CalDAV-Desktop/events.md

# Request timeout in milliseconds
WEBDAV_TIMEOUT_MS=20000

# ===== AI Parsing (enhancement for natural-language quick create) =====
# The calendar's "just say it" bar. **Local Chinese rule parsing always works**
# — AI only handles long/complex sentences that rules can't cover, plus speech-to-text.
#
# Requires an OpenAI-compatible endpoint (/chat/completions). Common values:
#   DeepSeek   https://api.deepseek.com/v1
#   Qwen       https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama     http://localhost:11434/v1
#   Moonshot   https://api.moonshot.cn/v1
# Leave blank to use local parsing only (still works, no AI features).
#
# NOTE: AI_API_KEY is read by the backend only — never exposed to the browser.
AI_ENABLED=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_TEMPERATURE=0.1

# Speech-to-text (Whisper). The provider behind AI_BASE_URL must expose
# /audio/transcriptions. When unset, the browser's built-in Web Speech API is used.
AI_WHISPER_MODEL=whisper-1
AI_WHISPER_LANGUAGE=zh

# ===== Calendar Display =====
# Default date range for fetching events (days)
VITE_DEFAULT_DATE_RANGE_DAYS=30