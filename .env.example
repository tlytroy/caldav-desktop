# ===== 统一数据源（唯一事实源）=====
# 事件、任务、清单、子任务全部存在这一个 Markdown 文件里。
# 日历 / 看板 / 工作台都是它的视图，不各自维护数据。
# 详见 REF/DATA_SOURCE.md
#
# 注意：路径类配置**环境变量优先**于 config.json（容器部署习惯）。
WORKSPACE_FILE=./workspace.md

# ---- 旧双文件架构（2026-10-26 废弃，v0.3 已从服务端删除）----
# 服务端不再读这两个变量；只有一次性迁移脚本 scripts/migrate-to-workspace.js
# 仍然能识别旧文件名（通过 --from <dir> 定位，不读环境变量）。
# MD_EVENTS_FILE=./events.md
# KANBAN_FILE_PATH=./工作搭子看板.md

# Server port
PORT=3001

# Electron configuration
VITE_API_URL=http://localhost:3001

# ===== CalDAV（可选同步通道）=====
# 连不上不影响本地功能：服务端先监听端口，再后台探测 CalDAV。
# 同步的是统一数据源 workspace.md（不再是废弃的 events.md）。
CALDAV_ROOT_URL=http://localhost:5232
CALDAV_USER=your_username
CALDAV_PASS=your_password

# 目标日历 URL（可选）。留空 = 自动发现第一个日历。
# Radicale 一般是 http://host:5232/<user>/<collection>/
CALDAV_CALENDAR_URL=

# 单次请求超时（毫秒）
CALDAV_TIMEOUT_MS=15000

# 同步方向："md-to-caldav" | "caldav-to-md" | "bidirectional"
# （也兼容 push / pull / both，内部会归一化）
MD_ICS_SYNC_DIRECTION=bidirectional

# 自动同步间隔（分钟），0 = 仅手动。
# 现在走的是 workspace.md ↔ CalDAV 通道，接口：POST /api/caldav/sync
MD_ICS_AUTO_SYNC_MINUTES=0

# ===== WebDAV 同步（没有 CalDAV 时的替代方案）=====
# 直接把 workspace.md 原样传到 WebDAV，不做 ICS 转换。
WEBDAV_URL=
WEBDAV_USER=
WEBDAV_PASS=

# 远端目录。**只取目录部分** —— 远端固定使用 workspace.md 这个文件名。
WEBDAV_EVENTS_PATH=CalDAV-Desktop

# Request timeout in milliseconds
WEBDAV_TIMEOUT_MS=20000

# ===== 提醒推送（可选，服务端 → 手机）=====
# 与渲染进程的应用内提醒互不影响。也可以在网页「通知推送」里配置（config.json）。
# 填了任一渠道的 key 会自动打开总开关；显式 NOTIFY_ENABLED=false 可强制关闭。
NOTIFY_ENABLED=false
WECOM_WEBHOOK=
SERVERCHAN_SENDKEY=
PUSHPLUS_TOKEN=
BARK_SERVER_URL=https://api.day.app
BARK_DEVICE_KEY=
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
NOTIFY_WEBHOOK_URL=

# ===== AI Parsing (enhancement for natural-language quick create) =====
# The calendar's "just say it" bar. **Local Chinese rule parsing always works**
# — AI only handles long/complex sentences that rules can't cover, plus speech-to-text.
#
# Requires an OpenAI-compatible endpoint (/chat/completions). Common values:
#   DeepSeek   https://api.deepseek.com/v1
#   Qwen       https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama     http://localhost:11434/v1
#   Moonshot   https://api.moonshot.cn/v1
# Leave blank to use local parsing only (still works, no AI features).
#
# NOTE: AI_API_KEY is read by the backend only — never exposed to the browser.
AI_ENABLED=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_TEMPERATURE=0.1

# Speech-to-text (Whisper). The provider behind AI_BASE_URL must expose
# /audio/transcriptions. When unset, the browser's built-in Web Speech API is used.
AI_WHISPER_MODEL=whisper-1
AI_WHISPER_LANGUAGE=zh

# ===== Calendar Display =====
# Default date range for fetching events (days)
VITE_DEFAULT_DATE_RANGE_DAYS=30
